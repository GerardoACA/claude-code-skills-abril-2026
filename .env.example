# ──────────────────────────────────────────────────────────────
#  Configuración del Chatbot del Despacho — copia este archivo a .env
# ──────────────────────────────────────────────────────────────

# --- Base de datos (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+psycopg://chatbot:chatbot@localhost:5432/chatbot

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# Modelo conversacional. Por defecto Sonnet 4.6: el mejor equilibrio entre
# calidad, latencia y costo para un chatbot de alto volumen con tool use.
# Súbelo a claude-opus-4-8 para máxima capacidad. (claude-client detecta el
# modelo y solo envía `effort`/adaptive thinking en los que lo soportan.)
CLAUDE_MODEL=claude-sonnet-4-6

# --- Embeddings (Voyage AI, recomendado por Anthropic para RAG) ---
VOYAGE_API_KEY=pa-...
VOYAGE_MODEL=voyage-3.5

# --- Meta (WhatsApp Cloud API + Instagram Messaging) ---
# Token de la app de Meta (System User token de larga duración)
META_ACCESS_TOKEN=
# Token que TÚ defines para verificar el webhook de Meta (cualquier string secreto)
META_VERIFY_TOKEN=cambia-esto-por-un-secreto
# App Secret de la app de Meta, para validar la firma X-Hub-Signature-256
META_APP_SECRET=
# ID del número de teléfono de WhatsApp Business (Phone Number ID)
WHATSAPP_PHONE_NUMBER_ID=
# ID de la cuenta de Instagram (IG user id vinculado a la Página)
INSTAGRAM_ACCOUNT_ID=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Token secreto del webhook de Telegram (lo defines tú y lo registras con setWebhook)
TELEGRAM_WEBHOOK_SECRET=cambia-esto-por-un-secreto

# --- Handoff al abogado (notificaciones) ---
# Chat ID de Telegram del abogado/grupo del despacho donde llegan los leads calientes
LAWYER_TELEGRAM_CHAT_ID=

# --- Privacidad (LFPDPPP) ---
# Enlace al aviso de privacidad integral del despacho (se incluye en el mensaje inicial)
PRIVACY_NOTICE_URL=

# --- Google Calendar ---
# Camino OAuth (recomendado para cuenta personal como formato212@gmail.com):
GOOGLE_OAUTH_CLIENT_FILE=./google_client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=./google_token.json
# Camino Service Account (alternativo):
GOOGLE_CREDENTIALS_FILE=./google_credentials.json
# ID del calendario donde se agendan las citas
GOOGLE_CALENDAR_ID=formato212@gmail.com
# Zona horaria por defecto para las citas
DEFAULT_TIMEZONE=America/Mexico_City
