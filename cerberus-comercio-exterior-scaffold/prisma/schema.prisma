// CERBERUS COMERCIO EXTERIOR — modelo de datos (Prisma schema). NO es SIDF.
// ============================================================================
// PRODUCTO: CERBERUS COMERCIO EXTERIOR (SaaS nuevo). NO es SIDF.
//
// Schema único (Agente B es el ÚNICO dueño). Incluye los modelos mínimos de
// Fase 0/1 con las "reservas" del diseño v2 (§4): Partida/Valoración reservadas,
// máquina de estados del despacho, tres expedientes separados, capa probatoria.
//
// Convenciones DURAS del blueprint:
//  - Multi-tenant: toda tabla salvo `Tenant` lleva `tenantId @map("tenant_id")`.
//  - Hashing probatorio: SHA-256 hex (64 chars) -> @db.Char(64).
//  - Estado probatorio del artefacto: EVIDENCIA_PRELIMINAR | PRUEBA_OPONIBLE.
//  - Bitácora append-only con encadenamiento (sha256 + hashPrev).
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// Enums
// ============================================================================

/// Roles de aplicación dentro de un tenant (autorización a nivel app; el JWT
/// transporta `tenantId` y `rol`).
enum RolUsuario {
  ADMIN
  AGENTE
  OPERADOR
  AUDITOR
  AUTORIDAD
}

/// Tipo de aviso de privacidad publicado (alineado al módulo de privacidad).
enum TipoAviso {
  INTEGRAL
  CORTO_CAPTURA
}

/// Estado del Certificado de Sello Digital del importador (CFF 17-H / 17-H Bis).
enum EstadoCsd {
  ACTIVO
  RESTRINGIDO
  CANCELADO
}

/// Etapa del cliente frente al procedimiento del art. 69-B CFF (empresas que
/// facturan operaciones simuladas — EFOS/EDOS).
enum Etapa69b {
  NINGUNA
  PRESUNTO
  DESVIRTUADO
  DEFINITIVO
  SENTENCIA_FAVORABLE
}

/// Estado de vigencia del encargo conferido (B14/B21), verificado por operación.
enum EstadoEncargo {
  VIGENTE
  REVOCADO
  VENCIDO
}

/// Estado probatorio de un artefacto/documento en la capa de prueba.
/// PRELIMINAR = evidencia preliminar (sello local); OPONIBLE = prueba oponible
/// (sello calificado PSC/TSA, NOM-151).
enum EstadoProbatorio {
  EVIDENCIA_PRELIMINAR
  PRUEBA_OPONIBLE
}

/// Máquina de estados del despacho de importación (entidad propia; la
/// incidencia del rojo es un estado).
enum EstadoDespacho {
  ARMADO
  PREVALIDADO
  PRESENTACION_PENDIENTE
  SELECCION
  VERDE
  ROJO
  INCIDENCIA
  DOSSIER_GENERADO
}

/// Estados de la alerta 69-B (seis estados). Es ALERTA, no bloqueo.
enum Estado69b {
  PRESUNTO
  DESVIRTUADO
  DEFINITIVO
  SENTENCIA_FAVORABLE
  OVERRIDE
  CERRADO
}

/// Tipo de CFDI 4.0 emitido para el traslado de mercancías (Inc 13).
enum TipoComprobante {
  INGRESO
  TRASLADO
}

/// Estado del ciclo de vida del CFDI (Inc 13). BORRADOR = capturado, validado
/// y sellado localmente; TIMBRADO/CANCELADO/SUSTITUIDO los pondrá el PAC real.
enum EstadoCfdi {
  BORRADOR
  TIMBRADO
  CANCELADO
  SUSTITUIDO
}

/// Complemento fiscal incorporado al CFDI (Inc 13).
enum TipoComplemento {
  NINGUNO
  CARTA_PORTE_31
  COMERCIO_EXT_11
}

/// Motivos de cancelación 01..04 del estándar CFDI 4.0 (decisión C8: la
/// cancelación se modela desde el inicio).
enum MotivoCancelacion {
  M01
  M02
  M03
  M04
}

// ============================================================================
// Raíz multi-tenant
// ============================================================================

/// Tenant = agencia aduanal / agente (rol LFPDPPP: Responsable). Modelo raíz:
/// NO lleva tenantId. Todo lo demás cuelga de aquí.
model Tenant {
  id          String   @id @default(cuid())
  /// Nombre comercial / razón social.
  nombre      String
  /// RFC del tenant.
  rfc         String   @unique
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  usuarios                  Usuario[]
  contratosEncargo          ContratoEncargo[]
  clientes                  Cliente[]
  patentes                  Patente[]
  personasFisicas           PersonaFisicaAutorizada[]
  encargosConferidos        EncargoConferido[]
  expedientesKyc            ExpedienteKyc1414[]
  expedientesProbatorio     ExpedienteProbatorioDespacho[]
  expedientesDoble          ExpedienteDoble3142[]
  documentos                Documento[]
  operaciones               Operacion[]
  partidas                  Partida[]
  alertas69b                Alerta69b[]
  versionesAviso            VersionAviso[]
  consentimientos           ConsentimientoDatos[]
  bitacora                  BitacoraAuditoria[]
  verificaciones            VerificacionCumplimiento[]
  pasos                     PasoDespacho[]
  comprobantes              ComprobanteCfdi[]
  overrides                 OverrideAlerta[]
  efirmasEntregadas         EfirmaEntregada[]
  opinionesCumplimiento     OpinionCumplimientoIngestada[]
  pedimentos                Pedimento[]

  @@map("tenant")
}

/// Usuario operador del tenant. Autenticación vía NextAuth (JWT con tenantId+rol).
model Usuario {
  id         String     @id @default(cuid())
  tenantId   String     @map("tenant_id")
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email      String
  nombre     String
  rol        RolUsuario @default(OPERADOR)
  /// Hash de credencial (si aplica autenticación local).
  passwordHash String?  @map("password_hash")
  activo     Boolean    @default(true)
  creadoEn   DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@unique([tenantId, email])
  @@index([tenantId, rol])
  @@map("usuario")
}

/// Contrato de encargo LFPDPPP por tenant (instrucciones, subencargados).
/// Condición bloqueante del panel (Fase 0).
model ContratoEncargo {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Etiqueta de versión del contrato, p. ej. "v1".
  version       String
  /// Instrucciones del responsable al encargado.
  instrucciones String
  /// Subencargados autorizados (lista libre / JSON serializado).
  subencargados String?
  vigenteDesde  DateTime @default(now()) @map("vigente_desde")
  vigenteHasta  DateTime? @map("vigente_hasta")
  /// SHA-256 del cuerpo del contrato (prueba de qué se firmó).
  sha256        String?  @db.Char(64)

  @@unique([tenantId, version])
  @@index([tenantId, vigenteHasta])
  @@map("contrato_encargo")
}

// ============================================================================
// Importador / actores
// ============================================================================

/// Cliente / Importador del tenant.
model Cliente {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  rfc        String
  razonSocial String   @map("razon_social")
  /// Estado del Certificado de Sello Digital (CFF 17-H / 17-H Bis).
  estadoCsd  EstadoCsd @default(ACTIVO) @map("estado_csd")
  /// Etapa frente al art. 69-B CFF.
  etapa69b   Etapa69b  @default(NINGUNA) @map("etapa_69b")
  creadoEn   DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  expedienteKyc        ExpedienteKyc1414?
  expedienteProbatorio ExpedienteProbatorioDespacho?
  expedienteDoble      ExpedienteDoble3142?
  encargosConferidos   EncargoConferido[]
  operaciones          Operacion[]
  alertas69b           Alerta69b[]
  verificaciones       VerificacionCumplimiento[]
  overrides            OverrideAlerta[]
  efirmasEntregadas    EfirmaEntregada[]
  opinionesCumplimiento OpinionCumplimientoIngestada[]

  @@unique([tenantId, rfc])
  @@index([tenantId, estadoCsd])
  @@index([tenantId, etapa69b])
  @@map("cliente")
}

/// Patente aduanal del tenant. Atribución por acto (acto crítico se firma y se
/// atribuye a una persona física + patente).
model Patente {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  numero    String
  /// Titular de la patente (nombre legible).
  titular   String?
  activa    Boolean  @default(true)
  creadoEn  DateTime @default(now()) @map("creado_en")

  personasFisicas PersonaFisicaAutorizada[]
  operaciones     Operacion[]

  @@unique([tenantId, numero])
  @@index([tenantId, activa])
  @@map("patente")
}

/// Persona física autorizada (mandatario / agente) ligada a una patente.
model PersonaFisicaAutorizada {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patenteId  String   @map("patente_id")
  patente    Patente  @relation(fields: [patenteId], references: [id], onDelete: Cascade)

  nombre     String
  rfc        String?
  curp       String?
  /// Identificador de la e.firma (FIEL) usada para atribuir actos.
  efirmaSerie String? @map("efirma_serie")
  activa     Boolean  @default(true)
  creadoEn   DateTime @default(now()) @map("creado_en")

  @@index([tenantId, patenteId])
  @@map("persona_fisica_autorizada")
}

/// Encargo conferido (B14/B21) con vigencia/estado, verificado por operación.
model EncargoConferido {
  id              String        @id @default(cuid())
  tenantId        String        @map("tenant_id")
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clienteId       String        @map("cliente_id")
  cliente         Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// "B14" | "B21" u otro tipo de aviso de encargo.
  tipo            String
  estado          EstadoEncargo @default(VIGENTE)
  /// Firma electrónica del cliente que confiere el encargo.
  efirmaCliente   String?       @map("efirma_cliente")
  /// Aceptación del agente.
  aceptacionAgente Boolean      @default(false) @map("aceptacion_agente")
  vigenciaInicio  DateTime      @map("vigencia_inicio")
  vigenciaFin     DateTime?     @map("vigencia_fin")
  creadoEn        DateTime      @default(now()) @map("creado_en")

  operaciones     Operacion[]

  @@index([tenantId, clienteId, estado])
  @@map("encargo_conferido")
}

// ============================================================================
// Tres expedientes separados (custodio y plazo de retención propios)
// ============================================================================

/// Expediente KYC art. 1414 (retención ~3 años). 1:1 con Cliente.
model ExpedienteKyc1414 {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clienteId  String   @unique @map("cliente_id")
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// Custodio responsable del expediente.
  custodio   String?
  /// Fecha límite de retención (plazo propio).
  retieneHasta DateTime? @map("retiene_hasta")
  creadoEn   DateTime @default(now()) @map("creado_en")

  documentos Documento[]

  @@index([tenantId])
  @@map("expediente_kyc_1414")
}

/// Expediente probatorio del despacho (~5 años, art. 30 CFF). 1:1 con Cliente.
model ExpedienteProbatorioDespacho {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clienteId  String   @unique @map("cliente_id")
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  custodio   String?
  retieneHasta DateTime? @map("retiene_hasta")
  creadoEn   DateTime @default(now()) @map("creado_en")

  documentos Documento[]

  @@index([tenantId])
  @@map("expediente_probatorio_despacho")
}

/// Expediente doble 3142 (agente + empresa). 1:1 con Cliente.
model ExpedienteDoble3142 {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clienteId  String   @unique @map("cliente_id")
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  custodio   String?
  retieneHasta DateTime? @map("retiene_hasta")
  creadoEn   DateTime @default(now()) @map("creado_en")

  documentos Documento[]

  @@index([tenantId])
  @@map("expediente_doble_3142")
}

/// Documento custodiado en alguno de los tres expedientes. Las versiones
/// históricas NO son purgables (prueba exculpatoria).
model Documento {
  id               String           @id @default(cuid())
  tenantId         String           @map("tenant_id")
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Tipo documental (libre / catálogo).
  tipo             String
  /// SHA-256 (hex, 64 chars) del contenido del documento.
  sha256           String           @db.Char(64)
  /// URL del objeto en almacenamiento WORM.
  wormUrl          String?          @map("worm_url")
  estadoProbatorio EstadoProbatorio @default(EVIDENCIA_PRELIMINAR) @map("estado_probatorio")
  /// Versión histórica (no purgable).
  version          Int              @default(1)
  /// Fecha de vencimiento del documento.
  vence            DateTime?
  creadoEn         DateTime         @default(now()) @map("creado_en")

  /// Pertenece a UNO de los tres expedientes (FK opcional por expediente).
  expedienteKycId        String?            @map("expediente_kyc_id")
  expedienteKyc          ExpedienteKyc1414? @relation(fields: [expedienteKycId], references: [id])
  expedienteProbatorioId String?            @map("expediente_probatorio_id")
  expedienteProbatorio   ExpedienteProbatorioDespacho? @relation(fields: [expedienteProbatorioId], references: [id])
  expedienteDobleId      String?            @map("expediente_doble_id")
  expedienteDoble        ExpedienteDoble3142? @relation(fields: [expedienteDobleId], references: [id])

  /// Operación a la que pertenece la evidencia (FK directa opcional; Inc 8).
  operacionId            String?            @map("operacion_id")
  operacion              Operacion?         @relation(fields: [operacionId], references: [id])

  @@index([tenantId, tipo])
  @@index([tenantId, estadoProbatorio])
  @@index([tenantId, vence])
  @@index([tenantId, operacionId])
  @@map("documento")
}

// ============================================================================
// Operación + máquina de estados del despacho + partida reservada
// ============================================================================

/// Operación de despacho de importación. La máquina de estados se modela con
/// el enum `EstadoDespacho` (la incidencia del rojo es un estado).
model Operacion {
  id             String         @id @default(cuid())
  tenantId       String         @map("tenant_id")
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clienteId      String         @map("cliente_id")
  cliente        Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// Atribución por patente (acto crítico).
  patenteId      String?        @map("patente_id")
  patente        Patente?       @relation(fields: [patenteId], references: [id])

  /// Encargo conferido verificado para esta operación.
  encargoId      String?        @map("encargo_id")
  encargo        EncargoConferido? @relation(fields: [encargoId], references: [id])

  /// Referencia interna del despacho.
  referencia     String
  estado         EstadoDespacho @default(ARMADO)
  creadoEn       DateTime       @default(now()) @map("creado_en")
  actualizadoEn  DateTime       @updatedAt @map("actualizado_en")

  partidas       Partida[]
  pasos          PasoDespacho[]
  documentos     Documento[]
  eventos        BitacoraAuditoria[]
  comprobantes   ComprobanteCfdi[]
  pedimentos     Pedimento[]

  @@unique([tenantId, referencia])
  @@index([tenantId, estado])
  @@index([tenantId, clienteId])
  @@map("operacion")
}

/// Partida / mercancía. RESERVADA desde Fase 0 para evitar reescritura.
model Partida {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  operacionId      String   @map("operacion_id")
  operacion        Operacion @relation(fields: [operacionId], references: [id], onDelete: Cascade)

  descripcion      String?
  /// Fracción arancelaria declarada (reservada).
  fraccionDeclarada String? @map("fraccion_declarada")
  /// Número de identificación comercial (reservado).
  nico             String?
  umt              String?
  origen           String?
  incoterm         String?
  /// Valor declarado (reservado).
  valorDeclarado   Decimal? @map("valor_declarado") @db.Decimal(18, 4)

  // Valoración aduanera + contribuciones (Incremento 31). Todo en MXN salvo tasas.
  /// Valor en aduana (base gravable) en MXN = valor de transacción + incrementables.
  valorAduana      Decimal? @map("valor_aduana") @db.Decimal(18, 2)
  /// Tasa de IGI (% ad valorem) de la fracción TIGIE.
  tasaIgiPct       Decimal? @map("tasa_igi_pct") @db.Decimal(7, 4)
  /// Tasa de IEPS (%) si la mercancía la causa.
  tasaIepsPct      Decimal? @map("tasa_ieps_pct") @db.Decimal(7, 4)
  igiImporte       Decimal? @map("igi_importe") @db.Decimal(18, 2)
  dtaImporte       Decimal? @map("dta_importe") @db.Decimal(18, 2)
  iepsImporte      Decimal? @map("ieps_importe") @db.Decimal(18, 2)
  ivaImporte       Decimal? @map("iva_importe") @db.Decimal(18, 2)
  /// Sello de integridad (SHA-256) de la partida capturada+calculada.
  sha256           String?  @db.Char(64)

  creadoEn         DateTime @default(now()) @map("creado_en")

  @@index([tenantId, operacionId])
  @@map("partida")
}

/// Pedimento (Incremento 31): resumen de contribuciones de una operación,
/// agregando sus partidas. Es registro probatorio (sellado); el cálculo real de
/// fracciones/regulaciones se enchufa con el conector ClasificadorArancel.
model Pedimento {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operacionId         String    @map("operacion_id")
  operacion           Operacion @relation(fields: [operacionId], references: [id], onDelete: Cascade)

  /// Clave de pedimento (p. ej. A1 importación definitiva).
  claveDePedimento    String    @map("clave_de_pedimento")
  /// Régimen aduanero (p. ej. IMPORTACION DEFINITIVA).
  regimen             String
  /// Tipo de cambio aplicado (MXN por USD) a la fecha del pedimento.
  tipoCambioUsd       Decimal   @map("tipo_cambio_usd") @db.Decimal(12, 4)

  valorAduanaTotal    Decimal   @map("valor_aduana_total") @db.Decimal(18, 2)
  igiTotal            Decimal   @map("igi_total") @db.Decimal(18, 2)
  dtaTotal            Decimal   @map("dta_total") @db.Decimal(18, 2)
  iepsTotal           Decimal   @map("ieps_total") @db.Decimal(18, 2)
  ivaTotal            Decimal   @map("iva_total") @db.Decimal(18, 2)
  contribucionesTotal Decimal   @map("contribuciones_total") @db.Decimal(18, 2)

  sha256              String    @db.Char(64)
  creadoEn            DateTime  @default(now()) @map("creado_en")

  @@index([tenantId, operacionId])
  @@map("pedimento")
}

// ============================================================================
// Alerta 69-B (alerta, no bloqueo)
// ============================================================================

/// Alerta del art. 69-B CFF por etapa. Es ALERTA, no bloqueo; el override se
/// firma (e.firma) y es inmutable.
model Alerta69b {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clienteId     String    @map("cliente_id")
  cliente       Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  estado        Estado69b @default(PRESUNTO)
  /// SHA-256 del snapshot del DOF que motivó la etapa.
  snapshotDofSha256 String? @map("snapshot_dof_sha256") @db.Char(64)
  snapshotDofFecha  DateTime? @map("snapshot_dof_fecha")

  /// Override firmado (e.firma del actor) — inmutable cuando estado = OVERRIDE.
  overrideEfirma String?  @map("override_efirma")
  overrideMotivo String?  @map("override_motivo")
  overrideEn     DateTime? @map("override_en")

  creadoEn       DateTime @default(now()) @map("creado_en")
  actualizadoEn  DateTime @updatedAt @map("actualizado_en")

  @@index([tenantId, clienteId, estado])
  @@map("alerta_69b")
}

// ============================================================================
// Privacidad (alineado a schema-consentimiento.prisma del módulo de privacidad)
// ============================================================================

/// Versión publicada del Aviso de Privacidad (integral o corto). Inmutable.
/// El hash es el SHA-256 del texto exacto publicado.
model VersionAviso {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tipo          TipoAviso
  /// Etiqueta legible, p. ej. "v2".
  version       String
  /// SHA-256 (hex, 64 chars) del cuerpo exacto del aviso publicado.
  hashAviso     String    @map("hash_aviso") @db.Char(64)
  /// Texto íntegro publicado (fuente del hash). Conservar para exporte probatorio.
  cuerpo        String
  vigenteDesde  DateTime  @default(now()) @map("vigente_desde")
  vigenteHasta  DateTime? @map("vigente_hasta")
  publicadoPor  String?   @map("publicado_por")

  consentimientos ConsentimientoDatos[]

  @@unique([tenantId, tipo, version])
  @@index([tenantId, tipo, vigenteHasta])
  @@map("version_aviso")
}

/// Registro de consentimiento expreso del titular para datos sensibles
/// (LFPDPPP art. 9). Una fila por acto; la revocación NO borra la fila.
model ConsentimientoDatos {
  id                   String   @id @default(cuid())
  tenantId             String   @map("tenant_id")
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Sujeto titular dentro del tenant (FK lógica al titular/operación).
  titularRef           String   @map("titular_ref")
  /// Operación / captura a la que pertenece el consentimiento (opcional).
  operacionRef         String?  @map("operacion_ref")

  /// Versión del aviso aceptada (aviso corto de captura, normalmente).
  versionAvisoId       String   @map("version_aviso_id")
  versionAviso         VersionAviso @relation(fields: [versionAvisoId], references: [id])
  /// Etiqueta de versión denormalizada para lectura rápida e independencia del FK.
  versionAvisoEtiqueta String   @map("version_aviso_etiqueta")
  /// SHA-256 del aviso que el titular tenía en pantalla al aceptar.
  hashAvisoPrivacidad  String   @map("hash_aviso_privacidad") @db.Char(64)

  /// Alcance otorgado.
  consienteBiometricos Boolean  @default(false) @map("consiente_biometricos")
  consienteGeoloc      Boolean  @default(false) @map("consiente_geoloc")
  /// true si el titular eligió "Continuar sin capturar evidencia sensible".
  rutaSinEvidencia     Boolean  @default(false) @map("ruta_sin_evidencia")

  /// Medio y metadatos del acto.
  medio                String   @default("WEB_PUNTO_CAPTURA")
  ipOrigen             String?  @map("ip_origen")
  userAgent            String?  @map("user_agent")

  /// Sello de integridad del registro.
  /// selloRegistro = SHA-256( payload canónico de este consentimiento ).
  selloRegistro        String   @map("sello_registro") @db.Char(64)
  /// Encadenamiento append-only con el sello del registro previo del tenant.
  hashPrev             String?  @map("hash_prev") @db.Char(64)

  /// Revocación (LFPDPPP art. 16 §6 aviso): sin efectos retroactivos.
  revocado             Boolean  @default(false)
  revocadoEn           DateTime? @map("revocado_en")
  motivoRevocacion     String?  @map("motivo_revocacion")

  creadoEn             DateTime @default(now()) @map("creado_en")

  @@index([tenantId, titularRef, creadoEn])
  @@index([tenantId, revocado])
  @@map("consentimiento_datos")
}

// ============================================================================
// Bitácora de auditoría (append-only, encadenada)
// ============================================================================

/// Bitácora append-only. Cada fila encadena con el sha256 de la fila previa del
/// tenant (`hashPrev`). No se actualiza ni borra (control probatorio).
model BitacoraAuditoria {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Actor que ejecutó la acción (usuario / e.firma).
  actor       String
  /// Acción registrada.
  accion      String
  /// Referencia al payload sellado (URL/ID externo), no el payload completo.
  payloadRef  String?  @map("payload_ref")
  /// SHA-256 (hex, 64 chars) del registro canónico.
  sha256      String   @db.Char(64)
  /// SHA-256 del registro previo del tenant (encadenamiento).
  hashPrev    String?  @map("hash_prev") @db.Char(64)
  /// Estado del sello calificado del registro.
  estadoSello EstadoProbatorio @default(EVIDENCIA_PRELIMINAR) @map("estado_sello")

  /// Operación a la que pertenece el evento (FK directa opcional; Inc 8).
  operacionId String?  @map("operacion_id")
  operacion   Operacion? @relation(fields: [operacionId], references: [id])

  creadoEn    DateTime @default(now()) @map("creado_en")

  @@index([tenantId, creadoEn])
  @@index([tenantId, accion])
  @@index([tenantId, operacionId])
  @@map("bitacora_auditoria")
}

// ============================================================================
// Verificación de cumplimiento (Incremento 5) — alcance ampliado del KYC
// más allá del 69-B (art. 69, 69-B, 69-B Bis, 49 Bis, opinión 32-D, CSD 17-H).
// Principio C9: ALERTA y registra, NUNCA bloquea. Alerta69b se conserva.
// ============================================================================

/// Fuente/supuesto verificado del cumplimiento fiscal del cliente/proveedor.
enum FuenteVerificacion {
  ART_69          // créditos firmes / no localizados (listado SAT)
  ART_69B         // EFOS/EDOS (operaciones inexistentes)
  ART_69B_BIS     // transmisión indebida de pérdidas
  ART_49BIS       // supuesto que inhabilita operaciones (art. 49 Bis CFF, confirmado por el
                  // cliente en Inc 9.1; la migración renombra el valor — si Prisma propone
                  // drop+add, es aceptable: los datos existentes son stub demo)
  OPINION_32D     // opinión de cumplimiento de obligaciones fiscales
  CSD_17H         // restricción/cancelación de sello digital
  SANCIONES_INT   // listas de sanciones internacionales (OFAC/SDN, ONU, UE, UK…)
                  // por ingesta manual; identifican por NOMBRE → match heurístico
                  // = SIEMPRE ALERTA con revisión humana (C9; Inc 12)
}

/// Resultado de la verificación por fuente.
enum ResultadoVerificacion {
  AL_CORRIENTE
  NO_DISPONIBLE
  ALERTA
  INHABILITADO_PRESUNTO
  INHABILITADO_DEFINITIVO
}

/// Verificación de cumplimiento por cliente y fuente, con snapshot fechado.
model VerificacionCumplimiento {
  id             String                @id @default(cuid())
  tenantId       String                @map("tenant_id")
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteId      String                @map("cliente_id")
  cliente        Cliente               @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  fuente         FuenteVerificacion
  resultado      ResultadoVerificacion
  detalle        String?
  snapshotSha256 String?               @db.Char(64) @map("snapshot_sha256")
  consultadoEn   DateTime              @default(now()) @map("consultado_en")
  vigenciaHasta  DateTime?             @map("vigencia_hasta")
  creadoEn       DateTime              @default(now()) @map("creado_en")

  @@index([tenantId, clienteId, fuente])
  @@map("verificacion_cumplimiento")
}

// ============================================================================
// Trámite del despacho (Incremento 6) — pasos documentales del despacho:
// MVE/E2, COVE, Prevalidación (sello), Pago de contribuciones y DODA.
// Es una lista/checklist por operación; cada paso se sella (sha256) y registra.
// No bloquea; es registro probatorio.
// ============================================================================

/// Tipo de paso documental del despacho.
enum TipoPaso {
  MVE_E2
  COVE
  PREVALIDACION
  PAGO
  DODA
}

/// Paso documental del despacho de una operación (checklist sellado).
model PasoDespacho {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operacionId  String    @map("operacion_id")
  operacion    Operacion @relation(fields: [operacionId], references: [id], onDelete: Cascade)
  tipo         TipoPaso
  acuse        String?   // acuse/folio/referencia (MVE, COVE, DODA)
  sello        String?   // sello de prevalidación
  monto        Decimal?  @db.Decimal(14, 2)  // para PAGO (total de contribuciones)
  detalle      String?
  sha256       String    @db.Char(64)
  completadoEn DateTime  @default(now()) @map("completado_en")

  @@index([tenantId, operacionId, tipo])
  @@map("paso_despacho")
}

// ============================================================================
// Listados reales del SAT (Incremento 10) — tablas de referencia GLOBALES.
// Los listados (arts. 69, 69-B, 69-B Bis, 49 Bis CFF) son PÚBLICOS e iguales
// para todos los tenants → SIN tenant_id (el script de RLS no las toca:
// correcto por diseño; la escritura queda restringida al endpoint admin).
// ============================================================================

/// Importación (snapshot sellado) de un listado público del SAT.
model ImportacionListadoSat {
  id           String   @id @default(cuid())
  fuente       FuenteVerificacion   // ART_69 | ART_69B | ART_69B_BIS | ART_49BIS
  url          String
  sha256Archivo String  @db.Char(64) @map("sha256_archivo")
  filas        Int
  /// Origen de la importación: AUTOMATICA (sync/cron) | MANUAL (ingesta admin; Inc 12).
  origen       String   @default("AUTOMATICA")
  /// Organismo emisor de la lista (p. ej. SAT, OFAC, ONU, UE, UK). Inc 12.
  emisor       String?
  importadoEn  DateTime @default(now()) @map("importado_en")
  entradas     ListadoSatEntrada[]
  @@index([fuente, importadoEn])
  @@map("importacion_listado_sat")
}

/// Entrada (RFC) de un listado del SAT importado. Referencia global.
model ListadoSatEntrada {
  id            String   @id @default(cuid())
  importacionId String   @map("importacion_id")
  importacion   ImportacionListadoSat @relation(fields: [importacionId], references: [id], onDelete: Cascade)
  fuente        FuenteVerificacion
  /// RFC opcional desde Inc 12: las listas internacionales (SANCIONES_INT)
  /// identifican por NOMBRE y no traen RFC. Las fuentes SAT siguen exigiéndolo.
  rfc           String?
  razonSocial   String?  @map("razon_social")
  situacion     String?  // texto de la columna "situación" del CSV (Presunto/Definitivo/etc.)
  @@index([rfc, fuente])
  @@index([razonSocial])
  @@map("listado_sat_entrada")
}

// ============================================================================
// CFDI + Carta Porte 3.1 (Incremento 13) — captura, validación y sellado local
// del comprobante; timbrado/cancelación detrás del conector TimbradorPac
// (NoOp hoy → PAC real del cliente después). Decisión C8: la cancelación
// (motivos 01-04) se modela desde el inicio.
// ============================================================================

/// CFDI de una operación con complemento (Carta Porte 3.1 / Comercio Ext 1.1).
model ComprobanteCfdi {
  id            String          @id @default(cuid())
  tenantId      String          @map("tenant_id")
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operacionId   String          @map("operacion_id")
  operacion     Operacion       @relation(fields: [operacionId], references: [id], onDelete: Cascade)
  tipo          TipoComprobante
  complemento   TipoComplemento @default(NINGUNO)
  estado        EstadoCfdi      @default(BORRADOR)
  emisorRfc     String          @map("emisor_rfc")
  receptorRfc   String          @map("receptor_rfc")
  /// Datos capturados (incluido el complemento) como JSON canónico (string).
  payload       String
  sha256        String          @db.Char(64)
  uuid          String?         // folio fiscal al timbrar (lo pondrá el PAC real)
  motivoCancelacion MotivoCancelacion? @map("motivo_cancelacion")
  sustituyeUuid String?         @map("sustituye_uuid")   // para motivo 01
  detallePac    String?         @map("detalle_pac")      // respuesta/estado del conector
  creadoEn      DateTime        @default(now()) @map("creado_en")
  actualizadoEn DateTime        @updatedAt @map("actualizado_en")

  @@index([tenantId, operacionId])
  @@index([tenantId, estado])
  @@map("comprobante_cfdi")
}

// ============================================================================
// Override firmado de alertas (Incremento 15) — decisión C11: cuando una
// verificación es adversa (ALERTA / INHABILITADO_*), el RESPONSABLE puede
// decidir continuar y ese acto queda motivado, atribuido, sellado y —cuando
// se integre la e.firma del titular— FIRMADO. El override NO borra ni altera
// la alerta: la acompaña (C9: el sistema alerta, el responsable decide).
// ============================================================================

/// Estado de firma electrónica del override (conector FirmadorEfirma; hoy
/// NoOp honesto = SIN_FIRMA "pendiente de firma electrónica").
enum EstadoFirmaOverride {
  SIN_FIRMA
  FIRMADO
}

model OverrideAlerta {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteId      String   @map("cliente_id")
  cliente        Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  fuente         FuenteVerificacion
  /// Resultado adverso que se decide sobrellevar (copia legible, p. ej. "INHABILITADO_PRESUNTO").
  resultado      String
  /// Motivación OBLIGATORIA del responsable (mínimo 20 caracteres).
  motivo         String
  actor          String
  /// SHA-256 del payload canónico del acto (cliente, fuente, resultado, motivo, actor, ts).
  sha256         String   @db.Char(64)
  estadoFirma    EstadoFirmaOverride @default(SIN_FIRMA) @map("estado_firma")
  /// Sello/serial del certificado cuando se firme con e.firma real (conector futuro).
  firmaDetalle   String?  @map("firma_detalle")
  creadoEn       DateTime @default(now()) @map("creado_en")

  @@index([tenantId, clienteId, fuente])
  @@map("override_alerta")
}

// ============================================================================
// e.firma entregada + validación de autenticidad (Incremento 20) — la opinión
// de cumplimiento (32-D) requiere la e.firma del contribuyente para consultarse
// en vivo ante el SAT. Como los clientes/proveedores NO siempre otorgan acceso
// directo, se les permite ENTREGAR su e.firma y un validador automático analiza
// la AUTENTICIDAD del certificado (emisor SAT, vigencia, RFC, huella) y deja un
// veredicto motivado.
//
// SEGURIDAD (decisión C14): SOLO se recibe/almacena el certificado PÚBLICO
// (.cer, X.509). La clave privada (.key) NUNCA se recibe ni se almacena; el
// endpoint la RECHAZA si detecta material privado. El certificado público es
// información pública por naturaleza (se publica al firmar). La consulta EN VIVO
// de la opinión 32-D ante el SAT/PSC sigue diferida (conector); esta capa
// habilita y sustenta esa gestión con una e.firma validada como auténtica.
// ============================================================================

/// Veredicto del validador automático de autenticidad de una e.firma entregada.
/// C9: incluso INVALIDA es una ALERTA registrada para revisión humana, no un
/// bloqueo de la operación del cliente.
enum ResultadoValidacionEfirma {
  VALIDA          // certificado auténtico (emisor SAT), vigente y RFC coincide
  ALERTA          // estructuralmente válido pero con observaciones (RFC no coincide, por vencer)
  INVALIDA        // emisor no reconocido, vencido o alterado
  NO_VERIFICABLE  // no se pudo parsear/analizar el material entregado
}

/// e.firma (certificado público .cer) entregada por el cliente/proveedor para
/// sustentar la gestión de su opinión de cumplimiento (32-D). Se guarda SOLO el
/// certificado público y los metadatos extraídos; la clave privada nunca entra
/// al sistema (C14).
model EfirmaEntregada {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteId      String   @map("cliente_id")
  cliente        Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  /// Nombre del archivo entregado (referencia legible, p. ej. "efirma.cer").
  nombreArchivo  String?  @map("nombre_archivo")
  /// SHA-256 (hex, 64 chars) del certificado (DER) entregado — huella del archivo.
  sha256         String   @db.Char(64)
  /// RFC extraído del subject del certificado (si se pudo determinar).
  rfcCertificado String?  @map("rfc_certificado")
  /// Titular (subject/CN) del certificado.
  titular        String?
  /// Número de serie del certificado.
  serie          String?
  /// Emisor (issuer) del certificado.
  emisor         String?
  /// Vigencia del certificado.
  validoDesde    DateTime? @map("valido_desde")
  validoHasta    DateTime? @map("valido_hasta")
  /// Veredicto de la validación automática de autenticidad.
  resultado      ResultadoValidacionEfirma
  /// Observaciones/checks del validador (JSON serializado: lista de comprobaciones).
  observaciones  String
  /// Actor (del JWT) que registró la entrega.
  actor          String
  creadoEn       DateTime @default(now()) @map("creado_en")

  @@index([tenantId, clienteId])
  @@map("efirma_entregada")
}

// ============================================================================
// Opinión de cumplimiento (32-D) INGESTADA + validación de autenticidad
// (Incremento 22) — los clientes/proveedores normalmente NO entregan su e.firma
// (.cer), pero SÍ pueden entregar la OPINIÓN DE CUMPLIMIENTO IMPRESA/PDF que el
// SAT les emite. Se ingiere el texto de esa opinión, un validador automático
// analiza su AUTENTICIDAD (marcadores del SAT, folio/acuse, RFC, sentido,
// consistencia) para detectar documentos FALSOS, y —cuando se conecte— se coteja
// EN VIVO ante el SAT por folio (conector VerificadorOpinionSat, NoOp hoy).
//
// C9: un veredicto SOSPECHOSA/NO_AUTENTICA es una ALERTA para revisión humana,
// nunca un bloqueo. El cotejo en vivo por folio es lo que CONFIRMA de forma
// definitiva; el análisis por IA es el primer filtro contra falsificaciones.
// ============================================================================

/// Veredicto del validador automático de autenticidad de la opinión ingestada.
enum ResultadoValidacionOpinion {
  AUTENTICA       // marcadores del SAT + folio + RFC coincide + consistente
  SOSPECHOSA      // faltan elementos o hay inconsistencias: revisión humana
  NO_AUTENTICA    // sin marcadores del SAT / RFC no coincide / probable falsificación
  NO_VERIFICABLE  // no se pudo analizar el texto entregado
}

/// Estado del cotejo EN VIVO ante el SAT (conector VerificadorOpinionSat).
enum EstadoCotejoSat {
  NO_INTENTADO    // aún no se cotejó (o conector no configurado)
  CONFIRMADA      // el SAT confirma el folio/sentido
  DISCREPANCIA    // el SAT responde algo distinto a lo ingestado
  NO_DISPONIBLE   // conector no configurado / SAT no disponible
}

/// Sentido de la opinión de cumplimiento (art. 32-D CFF).
enum SentidoOpinion {
  POSITIVA
  NEGATIVA
  SIN_OBLIGACIONES
  NO_INSCRITO
  INDETERMINADO
}

/// Opinión de cumplimiento (32-D) entregada por el cliente e ingestada para
/// validar su autenticidad. Tenant-scoped.
model OpinionCumplimientoIngestada {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteId      String   @map("cliente_id")
  cliente        Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  /// Nombre del archivo entregado (referencia legible, p. ej. "opinion.pdf").
  nombreArchivo  String?  @map("nombre_archivo")
  /// SHA-256 (hex, 64 chars) del texto ingestado — huella probatoria.
  sha256         String   @db.Char(64)
  /// Texto íntegro ingestado (fuente del hash; conservar para exporte probatorio).
  textoOriginal  String   @map("texto_original")
  /// RFC extraído del documento (si se pudo determinar).
  rfcDocumento   String?  @map("rfc_documento")
  /// Folio / número de acuse extraído (clave para el cotejo en vivo).
  folio          String?
  /// Sentido detectado en el documento.
  sentido        SentidoOpinion @default(INDETERMINADO)
  /// Fecha de emisión detectada en el documento.
  fechaEmision   DateTime? @map("fecha_emision")
  /// Veredicto de la validación automática de autenticidad.
  resultado      ResultadoValidacionOpinion
  /// Observaciones/checks del validador (JSON serializado).
  observaciones  String
  /// Estado del cotejo EN VIVO ante el SAT (conector).
  cotejoEnVivo   EstadoCotejoSat @default(NO_INTENTADO) @map("cotejo_en_vivo")
  /// Detalle legible del cotejo en vivo (respuesta del conector).
  cotejoDetalle  String?  @map("cotejo_detalle")
  /// Actor (del JWT) que registró la ingesta.
  actor          String
  creadoEn       DateTime @default(now()) @map("creado_en")

  @@index([tenantId, clienteId])
  @@map("opinion_cumplimiento_ingestada")
}
