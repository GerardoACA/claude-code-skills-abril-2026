# CERBERUS COMERCIO EXTERIOR — variables de entorno (ejemplo). NO es SIDF.
# Copia este archivo a .env y completa los valores reales.

# --- Base de datos ---
# La app SIEMPRE se conecta con el rol cerberus_ce_app (SIN BYPASSRLS) para que
# las políticas RLS apliquen. NO uses aquí un superusuario ni el rol de migración.
DATABASE_URL="postgresql://cerberus_ce_app:CAMBIA_ESTA_CLAVE@localhost:5432/cerberus_comercio_exterior?schema=public"

# Para correr `prisma migrate` y aplicar RLS necesitas un rol con permisos DDL
# (p. ej. el owner de la base). Úsalo solo en tareas de administración, no en runtime.
# DATABASE_URL_ADMIN="postgresql://cerberus_ce_owner:CAMBIA_ESTA_CLAVE@localhost:5432/cerberus_comercio_exterior?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET="CAMBIA_ESTE_SECRETO"
